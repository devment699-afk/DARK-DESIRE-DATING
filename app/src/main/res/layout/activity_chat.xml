<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dark_gradient">

    <!-- Chat Header -->
    <RelativeLayout
        android:id="@+id/chatHeader"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/bg_card"
        android:paddingHorizontal="12dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgPartnerAvatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:background="@color/bg_card_elevated"
            android:padding="2dp"
            android:src="@drawable/ic_launcher_foreground"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
            app:strokeColor="@color/accent_pink"
            app:strokeWidth="2dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:layout_toEndOf="@id/imgPartnerAvatar"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPartnerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="@string/chat_partner_default"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/viewStatusDot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/bg_radar_circle"
                    android:backgroundTint="@color/status_online" />

                <TextView
                    android:id="@+id/tvPartnerStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Connected"
                    android:textColor="@color/accent_cyan"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Action Buttons: Next & Leave -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNextStranger"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="@string/btn_next_stranger"
                android:textColor="@color/accent_pink"
                android:textSize="12sp"
                app:icon="@drawable/ic_skip"
                app:iconSize="16dp"
                app:iconTint="@color/accent_pink" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLeaveChat"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:text="@string/btn_leave"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                app:icon="@drawable/ic_stop"
                app:iconSize="16dp"
                app:iconTint="@color/text_secondary" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Disconnected Banner (Hidden by default) -->
    <TextView
        android:id="@+id/tvDisconnectedBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/chatHeader"
        android:background="#99FF0055"
        android:padding="8dp"
        android:text="@string/partner_left_msg"
        android:textAlignment="center"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Messages List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMessages"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/typingIndicator"
        android:layout_below="@id/tvDisconnectedBanner"
        android:clipToPadding="false"
        android:padding="12dp" />

    <!-- Typing Indicator -->
    <TextView
        android:id="@+id/typingIndicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/inputBar"
        android:paddingHorizontal="16dp"
        android:paddingVertical="4dp"
        android:text="@string/typing_indicator"
        android:textColor="@color/accent_pink"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Input Bar -->
    <LinearLayout
        android:id="@+id/inputBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <EditText
            android:id="@+id/etMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_input_dark"
            android:hint="@string/chat_type_hint"
            android:maxLines="4"
            android:minHeight="44dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/btnSend"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_button_glow"
            android:contentDescription="Send"
            android:src="@drawable/ic_send"
            app:tint="@color/text_primary" />
    </LinearLayout>

</RelativeLayout>
